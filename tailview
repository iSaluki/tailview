#!/usr/bin/env bash
# tailview — start the dashboard.
#
# Finds a Python 3.9+ interpreter and hands over to the package in src/.
# There is nothing to install: the whole tool is the standard library.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_python() {
  for candidate in python3 python3.13 python3.12 python3.11 python3.10 python3.9 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! python_bin="$(find_python)"; then
  echo "tailview needs Python 3.9 or newer." >&2
  echo "  Fedora:  sudo dnf install python3" >&2
  echo "  Debian:  sudo apt install python3" >&2
  echo "  macOS:   brew install python" >&2
  exit 1
fi

export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m tailview "$@"
